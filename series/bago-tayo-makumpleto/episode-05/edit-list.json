  "dialogue": [
    {
      "line": "L01",
      "text": "Bakit hindi mo sinabi sa akin?",
      "start": 0.25833333333333336,
      "end": 2.4183333333333334
    },
    {
      "line": "L02",
      "text": "Alam na ni Papa.",
      "start": 2.9666666666666672,
      "end": 4.766666666666667
    },
    {
      "line": "L03",
      "text": "Paano si Papa?",
      "start": 5.318333333333333,
      "end": 7.118333333333334
    },
    {
      "line": "L04",
      "text": "Ate, gusto ko rin namang may marating.",
      "start": 7.666666666666668,
      "end": 10.066666666666666
    },
    {
      "line": "L05",
      "text": "Alam ko, anak. Salamat sa pag-aalaga kay Mama.",
      "start": 10.633333333333335,
      "end": 14.753333333333334
    },
    {
      "line": "L06",
      "text": "Ngayon ko lang narinig 'yan, Pa.",
      "start": 15.299999999999997,
      "end": 17.259999999999998
    },
    {
      "line": "L07",
      "text": "Pasensya na. Nakalimutan kong ikaw rin, nawalan ng mama.",
      "start": 17.778333333333332,
      "end": 23.808333333333334
    },
    {
      "line": "L08",
      "text": "Pa, naayos ko na 'yung leave. May flight na ako.",
      "start": 24.716666666666665,
      "end": 28.596666666666664
    },
    {
      "line": "L09",
      "text": "Bago ka umalis, Marco... isang hapunan lang. Sama-sama tayo.",
      "start": 29.174999999999997,
      "end": 34.175
    },
    {
      "line": "L10",
      "text": "Ako na ang magluluto.",
      "start": 34.70166666666666,
      "end": 36.34166666666666
    },
    {
      "line": "L11",
      "text": "Ako naman sa hugasin.",
      "start": 36.87166666666666,
      "end": 38.91166666666666
    }
  ],
