  "dialogue": [
    {
      "line": "L01",
      "text": "Pa... kumain ka na?",
      "start": 0.25833333333333336,
      "end": 2.2183333333333333
    },
    {
      "line": "L02",
      "text": "Anak, nandito ka na.",
      "start": 2.7583333333333333,
      "end": 4.958333333333334
    },
    {
      "line": "L03",
      "text": "Ate, sa iyo ang hugasin.",
      "start": 14.883333333333333,
      "end": 17.483333333333334
    },
    {
      "line": "L04",
      "text": "Basta ikaw ang magluluto.",
      "start": 18.05,
      "end": 20.17
    },
    {
      "line": "L05",
      "text": "Teka. Apat pa rin?",
      "start": 20.71666666666667,
      "end": 23.236666666666668
    },
    {
      "line": "L06",
      "text": "Pa, iwan mo lang.",
      "start": 23.791666666666668,
      "end": 25.511666666666667
    },
    {
      "line": "L07",
      "text": "Ma... nakauwi na ako.",
      "start": 26.791666666666668,
      "end": 29.27166666666667
    },
    {
      "line": "L08",
      "text": "Kulang pa rin. Pero magkakasama tayo.",
      "start": 30.095000000000002,
      "end": 34.085
    },
    {
      "line": "L09",
      "text": "Kain na tayo, Pa.",
      "start": 34.84166666666667,
      "end": 36.52166666666667
    }
  ],
