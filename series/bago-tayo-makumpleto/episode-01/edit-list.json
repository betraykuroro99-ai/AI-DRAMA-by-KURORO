  ],
  "dialogue": [
    {
      "line": "L01",
      "text": "Mga anak, sa bahay tayo ngayong Pasko. Kumpleto tayo.",
      "start": 4.75,
      "end": 10.190000000000001
    },
    {
      "line": "L02",
      "text": "Pa, magpapadala ako sa Biyernes. Para sa handa.",
      "start": 21.149999999999995,
      "end": 25.309999999999995
    },
    {
      "line": "L03",
      "text": "Hindi yon ang tinatanong ko.",
      "start": 25.791666666666664,
      "end": 27.871666666666663
    },
    {
      "line": "L04",
      "text": "Titingnan ko yung flight mamaya.",
      "start": 28.334999999999997,
      "end": 30.815
    },
    {
      "line": "L05",
      "text": "Marco?",
      "start": 31.48,
      "end": 32.879999999999995
    },
    {
      "line": "L06",
      "text": "Baka may biyahe ako sa bente-kuwatro.",
      "start": 33.39166666666666,
      "end": 35.99166666666666
    },
    {
      "line": "L07",
      "text": "Kahit hapunan lang.",
      "start": 36.82166666666666,
      "end": 39.22166666666666
    },
    {
      "line": "L08",
      "text": "Sige, Pa. Message kami.",
      "start": 39.96499999999998,
      "end": 42.24499999999998
    },
    {
      "line": "L09",
      "text": "Paano ko sila pauuwiin nang hindi nag-aaway?",
      "start": 50.95833333333332,
      "end": 55.63833333333332
    }
  ]
}