  "dialogue": [
    {
      "line": "L01",
      "text": "Kumain ka na raw ba?",
      "start": 0.25833333333333336,
      "end": 1.9383333333333332
    },
    {
      "line": "L02",
      "text": "Ano, Pa?",
      "start": 2.5083333333333333,
      "end": 5.468333333333333
    },
    {
      "line": "L03",
      "text": "'Yun ang tanong ni Mama. Bago kami umalis papuntang ospital.",
      "start": 6.004999999999999,
      "end": 10.445
    },
    {
      "line": "L04",
      "text": "Nasa trabaho ako noon.",
      "start": 10.993333333333332,
      "end": 13.473333333333333
    },
    {
      "line": "L05",
      "text": "Alam niya.",
      "start": 14.053333333333333,
      "end": 15.293333333333331
    },
    {
      "line": "L06",
      "text": "Sabi ko, mamaya na kayo mag-usap.",
      "start": 15.841666666666667,
      "end": 19.121666666666666
    },
    {
      "line": "L07",
      "text": "Akala ko, may mamaya pa.",
      "start": 20.021666666666665,
      "end": 23.321666666666662
    },
    {
      "line": "L08",
      "text": "Pa... sorry.",
      "start": 24.341666666666665,
      "end": 26.901666666666664
    },
    {
      "line": "L09",
      "text": "Kumain ka muna, anak. Dito lang ako.",
      "start": 27.555,
      "end": 30.955
    },
    {
      "line": "L10",
      "text": "Pa, maghahanap na ako ng flight.",
      "start": 36.72666666666667,
      "end": 40.406666666666666
    }
  ],
