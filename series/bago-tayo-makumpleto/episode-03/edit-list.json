  "dialogue_captions": [
    {
      "speaker": "Elena",
      "text": "Lea, anak.",
      "start": 0.21,
      "end": 1.9
    },
    {
      "speaker": "Lea",
      "text": "Ma?",
      "start": 2.25,
      "end": 3.45
    },
    {
      "speaker": "Elena",
      "text": "Nakuha namin 'yung pinadala mo.",
      "start": 3.81,
      "end": 6.3
    },
    {
      "speaker": "Elena",
      "text": "Salamat, anak.",
      "start": 6.85,
      "end": 8.1
    },
    {
      "speaker": "Elena",
      "text": "Pero magtira ka rin para sa sarili mo, ha?",
      "start": 8.74,
      "end": 11.46
    },
    {
      "speaker": "Elena",
      "text": "Kung hindi ka makauwi ngayong Pasko,",
      "start": 12.43,
      "end": 14.76
    },
    {
      "speaker": "Elena",
      "text": "huwag kang mahiyang tumawag.",
      "start": 15.28,
      "end": 17.03
    },
    {
      "speaker": "Elena",
      "text": "Kahit wala kang padala.",
      "start": 17.5,
      "end": 19.23
    },
    {
      "speaker": "Elena",
      "text": "Anak pa rin kita, kahit malayo ka.",
      "start": 19.72,
      "end": 22.0
    },
    {
      "speaker": "Elena",
      "text": "Pag-uwi mo, may plato ka pa rin dito.",
      "start": 22.99,
      "end": 25.99
    },
    {
      "speaker": "Lea",
      "text": "Ma... bakit ngayon ko lang 'to narinig?",
      "start": 27.67,
      "end": 32.11
    },
    {
      "speaker": "Lea",
      "text": "Pa, noong tumawag si Mama... ano'ng sinabi niya?",
      "start": 36.41833333333332,
      "end": 42.21833333333332
    }
  ],
