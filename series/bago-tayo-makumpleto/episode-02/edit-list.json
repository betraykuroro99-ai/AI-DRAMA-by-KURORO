  "dialogue": [
    {
      "line": "L01",
      "text": "Pa?",
      "start": 1.05,
      "end": 3.21
    },
    {
      "line": "L02",
      "text": "Bakit nasa iyo ang cellphone ni Mama?",
      "start": 3.6333333333333333,
      "end": 6.593333333333333
    },
    {
      "line": "L03",
      "text": "Ako'ng nag-uwi. Galing ospital.",
      "start": 7.109999999999999,
      "end": 11.509999999999998
    },
    {
      "line": "L04",
      "text": "Akala ko, nawala.",
      "start": 11.993333333333332,
      "end": 13.793333333333333
    },
    {
      "line": "L05",
      "text": "Hindi naman lahat ng naiwan, hinahanap ninyo.",
      "start": 14.326666666666666,
      "end": 18.60666666666667
    },
    {
      "line": "L06",
      "text": "Marco...",
      "start": 19.401666666666664,
      "end": 20.801666666666662
    },
    {
      "line": "L07",
      "text": "Noong naospital si Mama, ako ang nandito. Ngayong Pasko, ako pa ang mag-a-adjust.",
      "start": 21.424999999999997,
      "end": 28.464999999999996
    },
    {
      "line": "L08",
      "text": "Hindi kita pinapauwi para mag-alaga.",
      "start": 29.25833333333333,
      "end": 32.29833333333333
    },
    {
      "line": "L09",
      "text": "Gusto kitang makasabay kumain.",
      "start": 33.19833333333333,
      "end": 35.678333333333335
    },
    {
      "line": "L10",
      "text": "Ate rin ba?",
      "start": 36.19833333333334,
      "end": 37.638333333333335
    },
    {
      "line": "L11",
      "text": "Oo. Pareho kayo.",
      "start": 38.245,
      "end": 40.845
    },
    {
      "line": "L12",
      "text": "Pa... may recording si Mama. Para kay Ate.",
      "start": 44.916666666666664,
      "end": 49.63666666666666
    }
  ]
}