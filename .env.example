# Copy to .env and fill in. Never commit or share .env.

# Token Station (OpenAI-compatible gateway): gpt-image-2 anchors, TTS voice samples
TOKEN_STATION_API_KEY=
# TOKEN_STATION_BASE_URL=https://bec.bytefuture.ai

# Alibaba Cloud Model Studio (Bailian) — Wan 3.0 video
# WAN_BASE_URL = your workspace endpoint, e.g. https://<workspace>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
WAN_API_KEY=
WAN_BASE_URL=

# Optional: whisper.cpp model for dialogue checks (auto-searched in $HOME if empty)
WHISPER_MODEL=

# Optional (not wired yet): Volcengine Ark for Seedance / Seedream
ARK_API_KEY=
ARK_REGION=cn-beijing
